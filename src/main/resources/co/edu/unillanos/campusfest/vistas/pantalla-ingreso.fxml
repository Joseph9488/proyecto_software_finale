<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="pantalla" spacing="10" prefWidth="420" stylesheets="@estilos.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Label styleClass="titulo" text="Registrar ingreso"/>
    <Label text="Id del evento"/>
    <TextField fx:id="campoEventoId"/>
    <Label text="Código de la reserva (QR)"/>
    <TextField fx:id="campoCodigo"/>
    <Button text="Registrar ingreso" onAction="#alRegistrar"/>
    <Label fx:id="etiquetaMensaje"/>
</VBox>
