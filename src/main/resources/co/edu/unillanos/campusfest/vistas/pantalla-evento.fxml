<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="pantalla" spacing="10" prefWidth="420" stylesheets="@estilos.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Label styleClass="titulo" text="Editar evento"/>
    <Label text="Id del evento"/>
    <TextField fx:id="campoEventoId"/>
    <Button text="Cargar evento" onAction="#alCargar"/>
    <Label text="Nombre"/>
    <TextField fx:id="campoNombre"/>
    <Label text="Fecha y hora (dd/MM/yyyy HH:mm)"/>
    <TextField fx:id="campoFecha" promptText="28/11/2026 19:00"/>
    <Label text="Lugar"/>
    <TextField fx:id="campoLugar"/>
    <Label text="Aforo"/>
    <TextField fx:id="campoAforo"/>
    <Button text="Guardar cambios" onAction="#alGuardar"/>
    <Label fx:id="etiquetaMensaje"/>
</VBox>
