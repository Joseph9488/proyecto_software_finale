<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" prefWidth="420" stylesheets="@estilos.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Label styleClass="titulo" text="Reservar y confirmar entrada"/>
    <Label text="Id del evento"/>
    <TextField fx:id="campoEventoId"/>
    <Label text="Id del estudiante"/>
    <TextField fx:id="campoEstudianteId"/>
    <Button text="Solicitar reserva" onAction="#alSolicitarReserva"/>
    <Label text="Código de la reserva"/>
    <TextField fx:id="campoCodigoReserva"/>
    <Button text="Confirmar reserva" onAction="#alConfirmarReserva"/>
    <Label fx:id="etiquetaMensaje"/>
</VBox>
